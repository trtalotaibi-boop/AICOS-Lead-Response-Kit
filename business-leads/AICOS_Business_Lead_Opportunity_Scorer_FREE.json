    {
      "id": "aa3d08c7-3eda-489a-8f97-f95b12d8cf7c",
      "name": "Score Sales Opportunity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const x = $json;\nlet score = 0;\nconst reasons = [];\nconst hasPhone = /^\\+?[0-9][0-9\\s-]{7,}$/.test(x.phone || \"\");\nconst hasEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(x.email || \"\");\nconst hasWebsite = /^https?:\\/\\//i.test(x.website || \"\");\nconst valid = Boolean(x.business_name && x.category && (hasPhone || hasEmail || hasWebsite));\nif (hasPhone) { score += 15; reasons.push(\"reachable by phone\"); }\nif (hasEmail) { score += 10; reasons.push(\"email available\"); }\nif (!hasWebsite) { score += 25; reasons.push(\"no website detected\"); }\nif (!x.online_booking) { score += 20; reasons.push(\"no online booking detected\"); }\nif (x.rating >= 4) { score += 10; reasons.push(\"strong customer rating\"); }\nif (x.reviews >= 20) { score += 10; reasons.push(\"proven local demand\"); }\nif (x.reviews >= 100) { score += 10; reasons.push(\"high review volume\"); }\nif (!valid) score = 0;\nconst priority = !valid ? \"REJECT\" : score >= 70 ? \"HIGH\" : score >= 45 ? \"MEDIUM\" : \"LOW\";\nconst angle = !valid ? \"Missing usable contact/business data\" : !hasWebsite ? \"Website / digital presence opportunity\" : !x.online_booking ? \"Online booking / conversion opportunity\" : \"Lead follow-up / automation opportunity\";\nreturn { json: { ...x, valid, score, priority, opportunity_reasons: reasons, outreach_angle: angle } };"
      }
    },
    {
      "id": "45be24ef-3448-4d68-a425-1f4026aed0f9",
