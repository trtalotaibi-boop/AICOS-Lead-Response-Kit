            {"id":"o-score","name":"score","type":"number","value":"={{ $json.score }}"},
            {"id":"o-priority","name":"priority","type":"string","value":"={{ $json.priority }}"},
            {"id":"o-valid","name":"valid","type":"boolean","value":"={{ $json.valid }}"},
            {"id":"o-angle","name":"outreach_angle","type":"string","value":"={{ $json.outreach_angle }}"},
            {"id":"o-reasons","name":"opportunity_reasons","type":"array","value":"={{ $json.opportunity_reasons }}"},
