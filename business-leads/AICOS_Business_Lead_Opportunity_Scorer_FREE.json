      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {"id":"n-name","name":"business_name","type":"string","value":"={{ ($json.business_name || \"\").trim() }}"},
            {"id":"n-category","name":"category","type":"string","value":"={{ ($json.category || \"Unknown\").trim() }}"},
            {"id":"n-city","name":"city","type":"string","value":"={{ ($json.city || \"\").trim() }}"},
            {"id":"n-phone","name":"phone","type":"string","value":"={{ ($json.phone || \"\").trim() }}"},
            {"id":"n-email","name":"email","type":"string","value":"={{ ($json.email || \"\").trim() }}"},
            {"id":"n-website","name":"website","type":"string","value":"={{ ($json.website || \"\").trim() }}"},
            {"id":"n-rating","name":"rating","type":"number","value":"={{ Number($json.rating || 0) }}"},
            {"id":"n-reviews","name":"reviews","type":"number","value":"={{ Number($json.reviews || 0) }}"},
            {"id":"n-booking","name":"online_booking","type":"boolean","value":"={{ Boolean($json.online_booking) }}"},
            {"id":"n-maps","name":"maps_url","type":"string","value":"={{ $json.maps_url || \"\" }}"},
