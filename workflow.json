      "id": "045da7d7-bd87-4953-8493-01248db50857",
      "name": "Lead Input (Sample)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -656,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Clinic Config').item.json;\nconst PHONE_RE = /^\\+?[0-9]{8,15}$/;\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const svc = (cfg.service_weights && cfg.service_weights[j.service_type]) || 0;\n  const src = (cfg.source_weights && cfg.source_weights[j.source]) || 0;\n  const bonus = j.preferred_time ? (cfg.preferred_time_bonus || 0) : 0;\n  const score = svc + src + bonus;\n  const th = cfg.priority_thresholds || { high: 70, medium: 40 };\n  const priority = score >= th.high ? 'HIGH' : (score >= th.medium ? 'MEDIUM' : 'LOW');\n  const lead_id_valid = typeof j.lead_id === 'string' && j.lead_id.trim().length > 0;\n  const phone_valid = typeof j.phone === 'string' && PHONE_RE.test(j.phone);\n  const v_ok = lead_id_valid && phone_valid;\n  const reject_reason = v_ok ? null : (!lead_id_valid ? 'missing_lead_id' : 'invalid_phone');\n  let draft = cfg.followup_templates[priority.toLowerCase()];\n  draft = draft.split('{{name}}').join(j.name || '')\n                 .split('{{service_type}}').join(j.service_type || '')\n                 .split('{{preferred_time}}').join(j.preferred_time ? j.preferred_time : 'غير محدد');\n  return { json: { ...j, score, priority, v_ok, reject_reason, draft_preview: draft, sla_preview: cfg.sla_minutes[priority] } };\n});"
      },
