    {
      "parameters": {
        "jsCode": "const cfg = $('Clinic Config').item.json;\nconst re = /^\\+?[0-9]{8,15}$/;\nreturn $input.all().map(item => {\n  const lead = item.json;\n  const score = (cfg.service_weights?.[lead.service_type] || 0) + (cfg.source_weights?.[lead.source] || 0) + (lead.preferred_time ? (cfg.preferred_time_bonus || 0) : 0);\n  const th = cfg.priority_thresholds || { high: 70, medium: 40 };\n  const priority = score >= th.high ? 'HIGH' : (score >= th.medium ? 'MEDIUM' : 'LOW');\n  const valid = Boolean(lead.lead_id) && re.test(lead.phone || '');\n  return { json: { lead_id: lead.lead_id, name: lead.name, service_type: lead.service_type, score, priority, valid, reject_reason: valid ? null : (!lead.lead_id ? 'missing_lead_id' : 'invalid_phone') } };\n});"
      },
      "id": "free-score",
      "name": "Validate & Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
