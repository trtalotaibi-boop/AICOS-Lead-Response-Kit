      "id": "0963c090-bca9-401a-abb2-57cb9fe29d9f",
      "name": "Validate & Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Clinic Config').item.json; const re = /^\\+?[0-9]{8,15}$/; return $input.all().map(item => { const lead=item.json; const score=(cfg.service_weights?.[lead.service_type]||0)+(cfg.source_weights?.[lead.source]||0)+(lead.preferred_time?(cfg.preferred_time_bonus||0):0); const th=cfg.priority_thresholds||{high:70,medium:40}; const priority=score>=th.high?'HIGH':(score>=th.medium?'MEDIUM':'LOW'); const valid=Boolean(lead.lead_id)&&re.test(lead.phone||''); return {json:{lead_id:lead.lead_id,name:lead.name,service_type:lead.service_type,score,priority,valid,reject_reason:valid?null:(!lead.lead_id?'missing_lead_id':'invalid_phone')}}; });"
      }
    },
